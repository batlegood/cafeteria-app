@model Cliente
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Nebula Coffee - Registro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                /* Fondo degradado cafés */
                background: linear-gradient(135deg, #d7ccc8, #6d4c41);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .card {
                max-width: 400px;
                width: 100%;
                border-radius: 12px;
                background: linear-gradient(135deg, #efebe9, #8d6e63); /* tonos café claro y medio */
                color: #3e2723;
            }

            .logo {
                text-align: center;
                margin-top: 20px;
            }

                .logo img {
                    max-width: 100px;
                }

                .logo h4 {
                    margin-top: 10px;
                    font-weight: bold;
                    color: #4e342e;
                }

            .btn-coffee {
                background: linear-gradient(90deg, #6d4c41, #a1887f);
                color: #fff;
                font-weight: bold;
            }

                .btn-coffee:hover {
                    background: linear-gradient(90deg, #5d4037, #8d6e63);
                }
    </style>
</head>
<body>

    <div class="card shadow">
        <div class="logo">
            <img src="~/static/logo.png" alt="Nebula Coffee Logo" />
            <h4>Nebula Coffee</h4>
        </div>
        <div class="card-body">
            <h5 class="text-center mb-4">Registro de Cliente</h5>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label">Cédula</label>
                    <input asp-for="Cedula" class="form-control" maxlength="10"
                           pattern="\d{6}|\d{8}|1\d{9}"
                           title="Solo 6, 8 o 10 dígitos. Si es de 10, debe empezar con 1." />
                    <span asp-validation-for="Cedula" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Correo</label>
                    <input asp-for="Correo" class="form-control" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-coffee w-100">Registrar Cliente</button>
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success text-center mt-3">
                        @ViewBag.Message
                    </div>
                }

            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>
